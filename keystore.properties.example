# Optional. Copy to keystore.properties (gitignored) to sign every build with one
# key, so new APKs install over old ones. Without it, builds use the debug key.
#
# Create a key:
#   keytool -genkeypair -v -keystore keystore/x4sync.jks -alias x4sync \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=keystore/x4sync.jks
storePassword=change-me
keyAlias=x4sync
keyPassword=change-me
